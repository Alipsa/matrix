# Whiskey Analysis

## Basic Information
```{groovy}
@Grab('se.alipsa.matrix:matrix-core:3.8.0')
@Grab('se.alipsa.matrix:matrix-csv:2.4.0')
@Grab('se.alipsa.matrix:matrix-stats:2.5.3-SNAPSHOT')
@Grab('se.alipsa.matrix:matrix-groovy-ext:0.3.0')
import se.alipsa.matrix.core.*
import se.alipsa.matrix.csv.*
import se.alipsa.matrix.xchart.*

m = CsvImporter.importCsv('https://www.niss.org/sites/default/files/ScotchWhisky01.txt')
    .drop('RowID')
out.println "Dimensions: " + m.dimensions()

```
<br /> 

## Fruity and sweet whiskeys

```{groovy}
features = m.columnNames() - 'Distillery'
features.each(feature -> m.apply(feature) { it.toDouble() / 4 })

selected= m.subset{ it.Fruity > 0.5 && it.Sweetness > 0.5 }

out.println selected.dimensions()
out.println selected, [width: '50%']

```
<br /> 

## Aberlour 

```{groovy}
import se.alipsa.matrix.xchart.*

transparency = 80
def aberlour = selected.subset(0..0)
def rc = RadarChart.create(aberlour, 600, 500)
    .setTitle('aberlour')
    .addSeries('Distillery', transparency)
out.println rc
```

## Distilleries
```{groovy}
import se.alipsa.matrix.xchart.*

rc = RadarChart.create(selected, 680, 500)
    .setTitle("Distilleries")
    .addSeries('Distillery', transparency)
out.println rc
```

## Cluster analysis
```{groovy}
import se.alipsa.matrix.core.*
import se.alipsa.matrix.stats.cluster.KMeans

def iterations = 20

def km = new KMeans(m)
def mCluster = km.fit(features, 3, iterations, 'Cluster')

def result = GQ {
  from w in mCluster
  groupby w.Cluster
  orderby w.Cluster
  select w.Cluster, count(w.Cluster) as Count
}
out.println "Cluster allocation using GQ"
out.println Matrix.builder('Cluster allocation').ginqResult(result).build(), [width: '20%']

out.println "Cluster allocation using countBy"
out.println mCluster.rows().countBy{ it.Cluster }

Map<?, Matrix> whiskeyClusters = mCluster.split('Cluster')

whiskeyClusters.each {
  out.println ' '
  out.print "**Cluster $it.key:** "
  out.println it.value.Distillery
}

import se.alipsa.matrix.stats.dimred.Pca
import se.alipsa.matrix.xchart.*

// PCA projection onto the two first principal components
def pca = Pca.fit(m, features)
mCluster['X'] = pca.scores(0)
mCluster['Y'] = pca.scores(1)
out.println "Variance explained by PC1 + PC2: ${(pca.cumulativeExplainedVariance()[1] * 100).round(1)}%"

def clusters = mCluster['Cluster'].toSet()
def sc = ScatterChart.create(mCluster, 700, 500)
sc.title = 'Whisky Flavor Clusters'
for (i in clusters) {
  def series = mCluster.subset('Cluster', i)
  sc.addSeries("Cluster $i", series.column('X'), series.column('Y'))
}

out.println sc
```
## Correlation Heatmap
```{groovy}
@Grab('se.alipsa.matrix:matrix-xchart:0.3.2')
@Grab('se.alipsa.matrix:matrix-stats:2.5.3-SNAPSHOT')
import se.alipsa.matrix.core.*
import se.alipsa.matrix.xchart.*

def hc = CorrelationHeatmapChart.create(m, 820, 500)
    .addSeries('Heat Series', features)

out.println hc
```
