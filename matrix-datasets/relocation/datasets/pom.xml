<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>se.alipsa.groovy</groupId>
  <artifactId>datasets</artifactId>
  <version>1.0.1</version>
  <packaging>pom</packaging>

  <name>Common datasets (relocated)</name>
  <description>Relocation of datasets to matrix-datasets following the project rename.</description>
  <url>https://github.com/Alipsa/matrix/tree/main/matrix-datasets</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/Alipsa/matrix/blob/main/matrix-datasets/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>perNyfelt</id>
      <name>Per Nyfelt</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Alipsa/matrix.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Alipsa/matrix.git</developerConnection>
    <url>https://github.com/Alipsa/matrix/tree/main/matrix-datasets</url>
  </scm>

  <distributionManagement>
    <relocation>
      <groupId>se.alipsa.groovy</groupId>
      <artifactId>matrix-datasets</artifactId>
      <version>1.0.1</version>
      <message>datasets has been renamed to matrix-datasets, starting with version 1.0.1. Source is now maintained at https://github.com/Alipsa/matrix/tree/main/matrix-datasets. Later releases use groupId se.alipsa.matrix; migration may require API changes.</message>
    </relocation>
  </distributionManagement>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <deploymentName>${project.groupId}:${project.artifactId}:${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
